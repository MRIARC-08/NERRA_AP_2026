digraph NERRA {
graph [rankdir=LR, splines=ortho, nodesep=0.35, ranksep=0.75, bgcolor="white", fontname="Arial", labelloc="t", label="NERRA — PostgreSQL relational schema (22 tables)", fontsize=22];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.65];
subgraph cluster_0 { label="Identity"; color="#aab6c8"; style="rounded";
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">email VARCHAR(320) UNIQUE</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">password_hash</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">display_name</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
user_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>USER_SESSIONS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">user_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">refresh_token_hash</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">user_agent</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">ip_address</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">is_revoked</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">last_active_at</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">expires_at</TD></TR></TABLE>>];
user_settings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>USER_SETTINGS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">user_id UUID FK UNIQUE</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">anthropic_api_key</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">anthropic_base_url</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">primary_model</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">embedding_model</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">max_hop_depth</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">extra_config JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">updated_at</TD></TR></TABLE>>];
}
subgraph cluster_1 { label="Project and manuscript"; color="#aab6c8"; style="rounded";
projects [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>PROJECTS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">owner_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">title</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">genre</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
manuscripts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>MANUSCRIPTS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">title</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">raw_text</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">status</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapters_done</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapters_total</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">error_note</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
manuscript_versions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>MANUSCRIPT_VERSIONS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">manuscript_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">version_number</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">content_hash</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">raw_text</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">diff_summary JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
chapter_analyses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>CHAPTER_ANALYSES</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">manuscript_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter_number</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">content_hash</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">result JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">UNIQUE(manuscript,chapter,hash)</TD></TR></TABLE>>];
chunks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>CHUNKS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">manuscript_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter_number</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">content</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">content_hash</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">paragraph_hashes JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">embedding VECTOR(384)</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
project_customizations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>PROJECT_CUSTOMIZATIONS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK UNIQUE</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">custom_context</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">custom_prompt</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">custom_validation JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">custom_graph_write JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">custom_ui_config JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">updated_at</TD></TR></TABLE>>];
}
subgraph cluster_2 { label="Story world"; color="#aab6c8"; style="rounded";
characters [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>CHARACTERS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">name</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">aliases JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">description</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">status</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">physical_traits JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">first_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">last_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
relationships [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>RELATIONSHIPS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">character_a_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">character_b_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">type</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">sentiment</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">description</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">evidence_quote</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">until_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
locations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>LOCATIONS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">name</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">description</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">first_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
objects [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>OBJECTS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">name</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">description</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">first_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">mention_chapters JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
object_custody_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>OBJECT_CUSTODY_EVENTS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">object_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">holder_type</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">holder_name</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">action</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">evidence_quote</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>EVENTS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter_number</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">scene_order</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">story_time_order</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">temporal_anchor</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">is_flashback</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">is_flashforward</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">summary</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">participants JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">location</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
}
subgraph cluster_3 { label="Claims and workflow"; color="#aab6c8"; style="rounded";
claims [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>CLAIMS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">subject</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">attribute</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">value</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">evidence_quote</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">source_paragraph_id</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">extraction_version</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">confidence</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">validation_state</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">status</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
validation_candidates [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>VALIDATION_CANDIDATES</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">manuscript_id UUID FK NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">candidate_type</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">payload JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">confidence</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">route</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">ambiguity_reason</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">source_paragraph_id</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">evidence_quote</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">status</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
knowledge_updates [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>KNOWLEDGE_UPDATES</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">character</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">fact</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">how_learned</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">source_character</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
world_rules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>WORLD_RULES</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">category</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">rule_text</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">source_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">is_author_defined</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">status</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
issues [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>ISSUES</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">type</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">severity</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">status</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">description</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">evidence JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">confidence</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">ai_reasoning</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">intent_classification</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">related_entities JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">claim_a_id UUID FK NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">claim_b_id UUID FK NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
correction_rules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>CORRECTION_RULES</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">rule_type</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">target_entity</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">instruction_text</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">payload JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">active</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at</TD></TR></TABLE>>];
plot_threads [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e9eef8"><B>PLOT_THREADS</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">id UUID PK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">project_id UUID FK</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">title</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">description</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">setup_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">payoff_chapter</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">status</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">related_entities JSONB</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">evidence_quote</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">updated_at</TD></TR></TABLE>>];
}
